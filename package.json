{
  "name": "new-name",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:design": "cd ai/design && bun run dev",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:design": "cd ai/design && bun run build",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "fix": "bun run check:fix && bun run check",
    "verify": "bun run fix && bun run compile && bun run test && bun run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "docs": "node scripts/generate-structure-docs.js",
    "commit": "git-cz",
    "e2e": "bun run build && playwright test -c playwright.config.noopen.ts",
    "e2e:report": "bun run build && playwright test -c playwright.config.report.ts",
    "e2e:install": "playwright install chromium",
    "test:manual": "node scripts/fixtures-server.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.44",
    "@heroicons/react": "^2.2.0",
    "@heroui/accordion": "^2.2.24",
    "@heroui/alert": "^2.2.27",
    "@heroui/button": "^2.2.27",
    "@heroui/card": "^2.2.25",
    "@heroui/checkbox": "^2.3.27",
    "@heroui/chip": "^2.2.22",
    "@heroui/divider": "^2.2.20",
    "@heroui/input": "^2.4.28",
    "@heroui/radio": "^2.3.27",
    "@heroui/react": "^2.8.5",
    "@heroui/select": "^2.4.28",
    "@heroui/skeleton": "^2.2.17",
    "@heroui/system": "2.4.27",
    "@heroui/tabs": "^2.2.24",
    "@heroui/theme": "2.4.23",
    "@heroui/toast": "^2.0.17",
    "@heroui/tooltip": "^2.2.24",
    "@heroui/use-theme": "^2.1.10",
    "@webext-core/messaging": "^2.3.0",
    "@webext-core/proxy-service": "^1.2.1",
    "ai": "^5.0.104",
    "framer-motion": "12.23.24",
    "idb-keyval": "^6.2.2",
    "mediainfo.js": "^0.3.6",
    "mupdf": "^1.26.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/module-react": "^1.1.5",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "tailwindcss": "^4.1.17",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.0.14",
    "wxt": "^0.20.11"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
