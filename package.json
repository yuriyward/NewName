{
  "name": "wxt-react-starter",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "fix": "bun run check:fix && bun run check",
    "verify": "bun run fix && bun run compile && bun run test && bun run build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "docs": "node scripts/generate-structure-docs.js",
    "commit": "git-cz",
    "e2e": "bun run build && playwright test -c playwright.config.noopen.ts",
    "e2e:report": "bun run build && playwright test -c playwright.config.report.ts",
    "e2e:install": "playwright install chromium",
    "test:manual": "node scripts/fixtures-server.mjs"
  },
  "dependencies": {
    "@heroui/alert": "^2.2.26",
    "@heroui/button": "^2.2.26",
    "@heroui/card": "^2.2.24",
    "@heroui/chip": "^2.2.21",
    "@heroui/divider": "^2.2.19",
    "@heroui/input": "^2.4.27",
    "@heroui/radio": "^2.3.26",
    "@heroui/react": "^2.8.4",
    "@heroui/skeleton": "^2.2.16",
    "@heroui/system": "2.4.22",
    "@heroui/theme": "2.4.22",
    "@heroui/toast": "^2.0.16",
    "framer-motion": "12.23.22",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@playwright/test": "^1.55.0",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/module-react": "^1.1.5",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "tailwindcss": "^4.1.13",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wxt": "^0.20.11"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
